<%- include('partials/header') %>

<main>
  <section>
    <h1>Contact Me</h1>
    <p>Feel free to reach out using the form below. Please kindly write your name, email, and phone number, and I will get back to you as soon as possible.</p>

    <form action="#" method="post">
      <label for="name">Name</label><br>
      <input type="text" id="name" name="name" required><br><br>

      <label for="email">Email</label><br>
      <input type="email" id="email" name="email" required><br><br>

      <label for="phone">Cell Number</label><br>
      <input type="tel" id="phone" name="phone" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" placeholder="123-456-7890" required><br><br>

      <label for="comments">Comments</label><br>
      <textarea id="comments" name="comments" rows="5" cols="40" maxlength="500" required></textarea><br><br>

      <input type="submit" value="Submit">
      <input type="reset" value="Reset">
    </form>
  </section>
</main>

<%- include('partials/footer') %>